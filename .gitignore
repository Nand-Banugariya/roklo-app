# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# expo
.expo/
expo-env.d.ts
.metro-health-check*

# native (generated by Expo prebuild; configure through app.json and plugins)
/ios
/android
.kotlin/
.gradle/
.cxx/
*.orig.*

# production
/build
/dist
/web-build
*.apk
*.aab
*.ipa

# testing
/coverage
test-results/
playwright-report/

# signing keys and credentials
credentials.json
*.keystore
*.jks
*.p8
*.p12
*.pfx
*.key
*.pem
*.mobileprovision
*.provisionprofile
/.aws/

# firebase (google-services.json comes from the EAS file variable GOOGLE_SERVICES_JSON)
google-services.json
*-firebase-adminsdk-*.json

# env files (examples can be committed)
.env*
!.env.example
!.env.sample
!.env.template

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# caches
.cache/
.eslintcache
.prettiercache
*.tsbuildinfo

# local databases (e.g. a copied roklo-inbox.db)
*.db
*.sqlite
*.sqlite3

# temporary files
/.tmp/
*.tmp
.history/

# stray media at the project root (the app's images live in assets/)
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.webp
/*.mp4
/*.mov

# editors (shared VS Code settings stay in Git)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# misc
.DS_Store
Thumbs.db
Desktop.ini

# local agent settings and reference project
/.codex/
/.claude/settings.local.json
example
